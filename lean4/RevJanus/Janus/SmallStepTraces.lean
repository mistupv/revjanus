module

public import RevJanus.Janus.SmallStepEquiv

/-!
# Janus: traces of small-step derivations

The paper calls the sequence of transition rules applied in a derivation its *trace*, and
claims that all balanced and loop traces are generated by the grammar

```
bal  ::= ε | AssVarS | AssArrS | CallS bal | UnCallS bal | Seq1 bal Seq2 bal
       | IfTrue1 bal IfTrue2 | IfFalse1 bal IfFalse2 | LoopMainS bal loop
loop ::= LoopBaseS | Loop1 bal Loop2 bal loop
```

This file formalizes rule names (`Rule`), the rule-labelled transition relation
(`SmallStepR`, equivalent to `SmallStep`), derivations with their traces (`TraceSteps`),
balanced and loop derivations with a given trace, the grammar (`BalTrace`, `LoopTrace`), and
proves the claim (`balanced_trace_mem_bal`, `loop_trace_mem_loop`).
-/

@[expose] public section

namespace Janus

open Relation

/-- Names of the transition rules of the small-step semantics. -/
inductive Rule where
  | assVarS | assArrS | callS | uncallS | seq1 | seq2
  | ifTrue1 | ifTrue2 | ifFalse1 | ifFalse2
  | loopMainS | loopBaseS | loop1 | loop2
  deriving DecidableEq, Repr

/-- The transition relation, labelled with the name of the applied rule. -/
inductive SmallStepR (Γ : ProcEnv) : Rule → SSConfig → SSConfig → Prop where
  | assVarS {σ : Store} {x : Var} {op : ModOp} {e : Expr} {v : Value} {S : Stack} :
      EvalExpr σ e v →
      SmallStepR Γ .assVarS ⟨σ, .assVar x op e, S⟩
        ⟨σ.update (.var x) (op.interp (σ (.var x)) v), .skip, S⟩
  | assArrS {σ : Store} {x : Var} {eₗ : Expr} {op : ModOp} {e : Expr} {vₗ v : Value}
      {S : Stack} :
      EvalExpr σ eₗ vₗ → EvalExpr σ e v →
      SmallStepR Γ .assArrS ⟨σ, .assArr x eₗ op e, S⟩
        ⟨σ.update (.elem x vₗ) (op.interp (σ (.elem x vₗ)) v), .skip, S⟩
  | callS {σ : Store} {id : ProcId} {s : Stmt} {S : Stack} :
      Γ id = some s → SmallStepR Γ .callS ⟨σ, .call id, S⟩ ⟨σ, s, S⟩
  | uncallS {σ : Store} {id : ProcId} {s : Stmt} {S : Stack} :
      Γ id = some s → SmallStepR Γ .uncallS ⟨σ, .uncall id, S⟩ ⟨σ, s.invert, S⟩
  | seq1 {σ : Store} {s₁ s₂ : Stmt} {S : Stack} :
      SmallStepR Γ .seq1 ⟨σ, .seq s₁ s₂, S⟩ ⟨σ, s₁, .seq s₂ :: S⟩
  | seq2 {σ : Store} {s₂ : Stmt} {S : Stack} :
      SmallStepR Γ .seq2 ⟨σ, .skip, .seq s₂ :: S⟩ ⟨σ, s₂, S⟩
  | ifTrue1 {σ : Store} {e₁ e₂ : Expr} {s₁ s₂ : Stmt} {v₁ : Value} {S : Stack} :
      EvalExpr σ e₁ v₁ → IsTrue v₁ →
      SmallStepR Γ .ifTrue1 ⟨σ, .ite e₁ s₁ s₂ e₂, S⟩ ⟨σ, s₁, .ifTrue e₂ :: S⟩
  | ifTrue2 {σ : Store} {e₂ : Expr} {v₂ : Value} {S : Stack} :
      EvalExpr σ e₂ v₂ → IsTrue v₂ →
      SmallStepR Γ .ifTrue2 ⟨σ, .skip, .ifTrue e₂ :: S⟩ ⟨σ, .skip, S⟩
  | ifFalse1 {σ : Store} {e₁ e₂ : Expr} {s₁ s₂ : Stmt} {v₁ : Value} {S : Stack} :
      EvalExpr σ e₁ v₁ → IsFalse v₁ →
      SmallStepR Γ .ifFalse1 ⟨σ, .ite e₁ s₁ s₂ e₂, S⟩ ⟨σ, s₂, .ifFalse e₂ :: S⟩
  | ifFalse2 {σ : Store} {e₂ : Expr} {v₂ : Value} {S : Stack} :
      EvalExpr σ e₂ v₂ → IsFalse v₂ →
      SmallStepR Γ .ifFalse2 ⟨σ, .skip, .ifFalse e₂ :: S⟩ ⟨σ, .skip, S⟩
  | loopMainS {σ : Store} {e₁ e₂ : Expr} {s₁ s₂ : Stmt} {v₁ : Value} {S : Stack} :
      EvalExpr σ e₁ v₁ → IsTrue v₁ →
      SmallStepR Γ .loopMainS ⟨σ, .loop e₁ s₁ s₂ e₂, S⟩ ⟨σ, s₁, .loop1 e₁ s₁ e₂ s₂ :: S⟩
  | loopBaseS {σ : Store} {e₁ e₂ : Expr} {s₁ s₂ : Stmt} {v₂ : Value} {S : Stack} :
      EvalExpr σ e₂ v₂ → IsTrue v₂ →
      SmallStepR Γ .loopBaseS ⟨σ, .skip, .loop1 e₁ s₁ e₂ s₂ :: S⟩ ⟨σ, .skip, S⟩
  | loop1 {σ : Store} {e₁ e₂ : Expr} {s₁ s₂ : Stmt} {v₂ : Value} {S : Stack} :
      EvalExpr σ e₂ v₂ → IsFalse v₂ →
      SmallStepR Γ .loop1 ⟨σ, .skip, .loop1 e₁ s₁ e₂ s₂ :: S⟩
        ⟨σ, s₂, .loop2 e₁ s₁ e₂ s₂ :: S⟩
  | loop2 {σ : Store} {e₁ e₂ : Expr} {s₁ s₂ : Stmt} {v₁ : Value} {S : Stack} :
      EvalExpr σ e₁ v₁ → IsFalse v₁ →
      SmallStepR Γ .loop2 ⟨σ, .skip, .loop2 e₁ s₁ e₂ s₂ :: S⟩
        ⟨σ, s₁, .loop1 e₁ s₁ e₂ s₂ :: S⟩

/-- The labelled relation is the transition relation `→` with rule names attached. -/
theorem smallStep_iff_exists_rule {Γ : ProcEnv} {c c' : SSConfig} :
    SmallStep Γ c c' ↔ ∃ r, SmallStepR Γ r c c' := by
  constructor
  · intro h
    cases h with
    | assVarS h => exact ⟨_, .assVarS h⟩
    | assArrS h₁ h₂ => exact ⟨_, .assArrS h₁ h₂⟩
    | callS h => exact ⟨_, .callS h⟩
    | uncallS h => exact ⟨_, .uncallS h⟩
    | seq1 => exact ⟨_, .seq1⟩
    | seq2 => exact ⟨_, .seq2⟩
    | ifTrue1 h₁ h₂ => exact ⟨_, .ifTrue1 h₁ h₂⟩
    | ifTrue2 h₁ h₂ => exact ⟨_, .ifTrue2 h₁ h₂⟩
    | ifFalse1 h₁ h₂ => exact ⟨_, .ifFalse1 h₁ h₂⟩
    | ifFalse2 h₁ h₂ => exact ⟨_, .ifFalse2 h₁ h₂⟩
    | loopMainS h₁ h₂ => exact ⟨_, .loopMainS h₁ h₂⟩
    | loopBaseS h₁ h₂ => exact ⟨_, .loopBaseS h₁ h₂⟩
    | loop1 h₁ h₂ => exact ⟨_, .loop1 h₁ h₂⟩
    | loop2 h₁ h₂ => exact ⟨_, .loop2 h₁ h₂⟩
  · rintro ⟨r, h⟩
    cases h with
    | assVarS h => exact .assVarS h
    | assArrS h₁ h₂ => exact .assArrS h₁ h₂
    | callS h => exact .callS h
    | uncallS h => exact .uncallS h
    | seq1 => exact .seq1
    | seq2 => exact .seq2
    | ifTrue1 h₁ h₂ => exact .ifTrue1 h₁ h₂
    | ifTrue2 h₁ h₂ => exact .ifTrue2 h₁ h₂
    | ifFalse1 h₁ h₂ => exact .ifFalse1 h₁ h₂
    | ifFalse2 h₁ h₂ => exact .ifFalse2 h₁ h₂
    | loopMainS h₁ h₂ => exact .loopMainS h₁ h₂
    | loopBaseS h₁ h₂ => exact .loopBaseS h₁ h₂
    | loop1 h₁ h₂ => exact .loop1 h₁ h₂
    | loop2 h₁ h₂ => exact .loop2 h₁ h₂

/-- `TraceSteps Γ P c t c'`: a derivation `c →* c'` with trace `t` (the list of applied
rules) whose intermediate stacks (after `c`) all satisfy `P`. -/
inductive TraceSteps (Γ : ProcEnv) (P : Stack → Prop) : SSConfig → List Rule → SSConfig → Prop
  | refl {c : SSConfig} : TraceSteps Γ P c [] c
  | head {c c₁ c' : SSConfig} {r : Rule} {t : List Rule} :
      SmallStepR Γ r c c₁ → P c₁.stack → TraceSteps Γ P c₁ t c' →
      TraceSteps Γ P c (r :: t) c'

/-- If the initial stack satisfies `P`, so does the final one. -/
theorem TraceSteps.last_prop {Γ : ProcEnv} {P : Stack → Prop} {c c' : SSConfig}
    {t : List Rule} (h : TraceSteps Γ P c t c') (hc : P c.stack) : P c'.stack := by
  induction h with
  | refl => exact hc
  | head _ hP _ ih => exact ih hP

/-- Derivations with traces are exactly the restricted derivations. -/
theorem reflTransGen_iff_exists_trace {Γ : ProcEnv} {P : Stack → Prop} {c c' : SSConfig} :
    ReflTransGen (SmallStepWithin Γ P) c c' ↔ ∃ t, TraceSteps Γ P c t c' := by
  constructor
  · intro h
    induction h using ReflTransGen.head_induction_on with
    | refl => exact ⟨[], .refl⟩
    | head hstep _ ih =>
      obtain ⟨t, ht⟩ := ih
      obtain ⟨r, hr⟩ := smallStep_iff_exists_rule.1 hstep.1
      exact ⟨r :: t, .head hr hstep.2 ht⟩
  · rintro ⟨t, h⟩
    induction h with
    | refl => exact .refl
    | head hr hP _ ih => exact .head ⟨smallStep_iff_exists_rule.2 ⟨_, hr⟩, hP⟩ ih

/-- `t` is the trace of a balanced derivation `c →* c'`. -/
def BalancedWithTrace (Γ : ProcEnv) (c : SSConfig) (t : List Rule) (c' : SSConfig) : Prop :=
  c.stack = c'.stack ∧ TraceSteps Γ (fun S' => c.stack <:+ S') c t c'

/-- `t` is the trace of a loop derivation
`⟨σ, skip, loop1(e₁,s₁,e₂,s₂) : S⟩ →* ⟨σ', skip, S⟩`. -/
def LoopWithTrace (Γ : ProcEnv) (σ : Store) (e₁ : Expr) (s₁ : Stmt) (e₂ : Expr) (s₂ : Stmt)
    (S : Stack) (t : List Rule) (σ' : Store) : Prop :=
  ∃ c t₀ r, TraceSteps Γ (fun S' => .loop1 e₁ s₁ e₂ s₂ :: S <:+ S' ∨
        .loop2 e₁ s₁ e₂ s₂ :: S <:+ S') ⟨σ, .skip, .loop1 e₁ s₁ e₂ s₂ :: S⟩ t₀ c ∧
    SmallStepR Γ r c ⟨σ', .skip, S⟩ ∧ t = t₀ ++ [r]

theorem balanced_iff_exists_trace {Γ : ProcEnv} {c c' : SSConfig} :
    Balanced Γ c c' ↔ ∃ t, BalancedWithTrace Γ c t c' := by
  unfold Balanced BalancedWithTrace
  rw [reflTransGen_iff_exists_trace]
  constructor
  · rintro ⟨h, t, ht⟩; exact ⟨t, h, ht⟩
  · rintro ⟨t, h, ht⟩; exact ⟨h, t, ht⟩

theorem loopDerivation_iff_exists_trace {Γ : ProcEnv} {σ σ' : Store} {e₁ e₂ : Expr}
    {s₁ s₂ : Stmt} {S : Stack} :
    LoopDerivation Γ σ e₁ s₁ e₂ s₂ S σ' ↔ ∃ t, LoopWithTrace Γ σ e₁ s₁ e₂ s₂ S t σ' := by
  constructor
  · rintro ⟨c, hd, hl⟩
    obtain ⟨t₀, ht₀⟩ := reflTransGen_iff_exists_trace.1 hd
    obtain ⟨r, hr⟩ := smallStep_iff_exists_rule.1 hl
    exact ⟨_, c, t₀, r, ht₀, hr, rfl⟩
  · rintro ⟨t, c, t₀, r, ht₀, hr, -⟩
    exact ⟨c, reflTransGen_iff_exists_trace.2 ⟨t₀, ht₀⟩, smallStep_iff_exists_rule.2 ⟨r, hr⟩⟩

mutual
/-- The grammar of balanced traces `bal`. -/
inductive BalTrace : List Rule → Prop
  | nil : BalTrace []
  | assVarS : BalTrace [.assVarS]
  | assArrS : BalTrace [.assArrS]
  | callS {b : List Rule} : BalTrace b → BalTrace (.callS :: b)
  | uncallS {b : List Rule} : BalTrace b → BalTrace (.uncallS :: b)
  | seq {b₁ b₂ : List Rule} : BalTrace b₁ → BalTrace b₂ →
      BalTrace (.seq1 :: b₁ ++ .seq2 :: b₂)
  | ifTrue {b : List Rule} : BalTrace b → BalTrace (.ifTrue1 :: b ++ [.ifTrue2])
  | ifFalse {b : List Rule} : BalTrace b → BalTrace (.ifFalse1 :: b ++ [.ifFalse2])
  | loopMain {b l : List Rule} : BalTrace b → LoopTrace l → BalTrace (.loopMainS :: b ++ l)

/-- The grammar of loop traces `loop`. -/
inductive LoopTrace : List Rule → Prop
  | base : LoopTrace [.loopBaseS]
  | step {b₁ b₂ l : List Rule} : BalTrace b₁ → BalTrace b₂ → LoopTrace l →
      LoopTrace (.loop1 :: b₁ ++ .loop2 :: b₂ ++ l)
end

/-! ### Proof of the claim

As for soundness, a configuration `⟨σ, s, F ++ S⟩` *trace-completes* above `S` with trace
`t` if `t = t₁ ++ t₂`, where `t₁ ∈ bal` (and `t₁ = ε` when `s = skip`) and `t₂` is a
concatenation of the traces expected by the items of `F`. -/

/-- Traces expected to pop a stack item. -/
def ItemTrace : StackItem → List Rule → Prop
  | .seq _, t => ∃ b, BalTrace b ∧ t = .seq2 :: b
  | .ifTrue _, t => t = [.ifTrue2]
  | .ifFalse _, t => t = [.ifFalse2]
  | .loop1 .., t => LoopTrace t
  | .loop2 .., t => ∃ b l, BalTrace b ∧ LoopTrace l ∧ t = .loop2 :: b ++ l

/-- Traces expected to pop a stack segment. -/
def FramesTrace : Stack → List Rule → Prop
  | [], t => t = []
  | it :: F, t => ∃ t₁ t₂, ItemTrace it t₁ ∧ FramesTrace F t₂ ∧ t = t₁ ++ t₂

@[simp] theorem FramesTrace.nil_iff {t : List Rule} : FramesTrace [] t ↔ t = [] := Iff.rfl

@[simp] theorem FramesTrace.cons_iff {it : StackItem} {F : Stack} {t : List Rule} :
    FramesTrace (it :: F) t ↔ ∃ t₁ t₂, ItemTrace it t₁ ∧ FramesTrace F t₂ ∧ t = t₁ ++ t₂ :=
  Iff.rfl

/-- Trace-completion of a configuration above the base stack `S`. -/
def TraceCompletes (S : Stack) (c : SSConfig) (t : List Rule) : Prop :=
  ∃ F t₁ t₂, c.stack = F ++ S ∧ t = t₁ ++ t₂ ∧ BalTrace t₁ ∧
    (c.control = .skip → t₁ = []) ∧ FramesTrace F t₂

theorem traceCompletes_pop {S T F₁ : Stack} {σ : Store} {it : StackItem}
    {t₁ t₂ : List Rule} (hst : T = F₁ ++ S) (hit : ItemTrace it t₁)
    (hfr : FramesTrace F₁ t₂) : TraceCompletes S ⟨σ, .skip, it :: T⟩ (t₁ ++ t₂) :=
  ⟨it :: F₁, [], t₁ ++ t₂, by simp [hst], rfl, .nil, fun _ => rfl,
    FramesTrace.cons_iff.2 ⟨t₁, t₂, hit, hfr, rfl⟩⟩

/-- One labelled transition reflects trace-completion backwards. -/
theorem SmallStepR.traceCompletes_back {Γ : ProcEnv} {S : Stack} {c c' : SSConfig}
    {r : Rule} {t : List Rule} (hstep : SmallStepR Γ r c c') (hS : S <:+ c.stack)
    (h : TraceCompletes S c' t) : TraceCompletes S c (r :: t) := by
  obtain ⟨F₁, t₁, t₂, hst, rfl, hb, hskip, hfr⟩ := h
  cases hstep with
  | assVarS he =>
    obtain rfl := hskip rfl
    exact ⟨F₁, [.assVarS], t₂, hst, rfl, .assVarS, by simp, hfr⟩
  | assArrS hl he =>
    obtain rfl := hskip rfl
    exact ⟨F₁, [.assArrS], t₂, hst, rfl, .assArrS, by simp, hfr⟩
  | callS hΓ => exact ⟨F₁, _, t₂, hst, rfl, .callS hb, by simp, hfr⟩
  | uncallS hΓ => exact ⟨F₁, _, t₂, hst, rfl, .uncallS hb, by simp, hfr⟩
  | seq1 =>
    obtain ⟨F, hF, rfl⟩ := frames_of_push hS hst
    obtain ⟨_, t₃, ⟨b, hb', rfl⟩, hfr₃, rfl⟩ := FramesTrace.cons_iff.1 hfr
    exact ⟨F, _, t₃, hF, by simp, .seq hb hb', by simp, hfr₃⟩
  | seq2 =>
    exact traceCompletes_pop (it := .seq _) hst ⟨t₁, hb, rfl⟩ hfr
  | ifTrue1 he₁ ht₁ =>
    obtain ⟨F, hF, rfl⟩ := frames_of_push hS hst
    obtain ⟨_, t₃, rfl, hfr₃, rfl⟩ := FramesTrace.cons_iff.1 hfr
    exact ⟨F, _, t₃, hF, by simp, .ifTrue hb, by simp, hfr₃⟩
  | ifTrue2 he₂ ht₂ =>
    obtain rfl := hskip rfl
    exact traceCompletes_pop (it := .ifTrue _) hst rfl hfr
  | ifFalse1 he₁ hf₁ =>
    obtain ⟨F, hF, rfl⟩ := frames_of_push hS hst
    obtain ⟨_, t₃, rfl, hfr₃, rfl⟩ := FramesTrace.cons_iff.1 hfr
    exact ⟨F, _, t₃, hF, by simp, .ifFalse hb, by simp, hfr₃⟩
  | ifFalse2 he₂ hf₂ =>
    obtain rfl := hskip rfl
    exact traceCompletes_pop (it := .ifFalse _) hst rfl hfr
  | loopMainS he₁ ht₁ =>
    obtain ⟨F, hF, rfl⟩ := frames_of_push hS hst
    obtain ⟨l, t₃, hl, hfr₃, rfl⟩ := FramesTrace.cons_iff.1 hfr
    exact ⟨F, _, t₃, hF, by simp, .loopMain hb hl, by simp, hfr₃⟩
  | loopBaseS he₂ ht₂ =>
    obtain rfl := hskip rfl
    exact traceCompletes_pop (it := .loop1 _ _ _ _) hst LoopTrace.base hfr
  | loop1 he₂ hf₂ =>
    rename_i σ e₁ e₂ s₁ s₂ v T
    obtain ⟨F, rfl, hF⟩ := frames_of_swap (by simp) hS hst
    obtain ⟨_, t₃, ⟨b, l, hb', hl, rfl⟩, hfr₃, rfl⟩ := FramesTrace.cons_iff.1 hfr
    have := traceCompletes_pop (σ := σ) (it := .loop1 e₁ s₁ e₂ s₂) hF (LoopTrace.step hb hb' hl) hfr₃
    simpa using this
  | loop2 he₁ hf₁ =>
    rename_i σ e₁ e₂ s₁ s₂ v T
    obtain ⟨F, rfl, hF⟩ := frames_of_swap (by simp) hS hst
    obtain ⟨l, t₃, hl, hfr₃, rfl⟩ := FramesTrace.cons_iff.1 hfr
    have := traceCompletes_pop (σ := σ) (it := .loop2 e₁ s₁ e₂ s₂) hF ⟨t₁, l, hb, hl, rfl⟩ hfr₃
    simpa using this

theorem traceCompletes_back_of_traceSteps {Γ : ProcEnv} {S : Stack} {P : Stack → Prop}
    (hP : ∀ T, P T → S <:+ T) {c c' : SSConfig} {t t' : List Rule}
    (h : TraceSteps Γ P c t c') (hc : S <:+ c.stack) (h' : TraceCompletes S c' t') :
    TraceCompletes S c (t ++ t') := by
  induction h with
  | refl => exact h'
  | head hr hPc _ ih => exact hr.traceCompletes_back hc (ih (hP _ hPc) h')

/-- Claim of the paper: every balanced trace is generated by the grammar `bal`. -/
theorem balanced_trace_mem_bal {Γ : ProcEnv} {σ σ' : Store} {s : Stmt} {S₁ S₂ : Stack}
    {t : List Rule} (h : BalancedWithTrace Γ ⟨σ, s, S₁⟩ t ⟨σ', .skip, S₂⟩) : BalTrace t := by
  obtain ⟨hS, hd⟩ := h
  simp only at hS
  subst hS
  have := traceCompletes_back_of_traceSteps (t' := []) (fun _ h => h) hd
    (List.suffix_refl _) ⟨[], [], [], rfl, rfl, .nil, fun _ => rfl, rfl⟩
  obtain ⟨F, t₁, t₂, hF, ht, hb, -, hfr⟩ := this
  have : F = [] := by simpa using hF
  subst this
  cases hfr
  simp only [List.append_nil] at ht
  subst ht
  exact hb

/-- Claim of the paper: every loop trace is generated by the grammar `loop`. -/
theorem loop_trace_mem_loop {Γ : ProcEnv} {σ σ' : Store} {e₁ e₂ : Expr} {s₁ s₂ : Stmt}
    {S : Stack} {t : List Rule} (h : LoopWithTrace Γ σ e₁ s₁ e₂ s₂ S t σ') :
    LoopTrace t := by
  obtain ⟨c, t₀, r, hd, hlast, rfl⟩ := h
  have hsuf : ∀ T, (StackItem.loop1 e₁ s₁ e₂ s₂ :: S <:+ T ∨
      StackItem.loop2 e₁ s₁ e₂ s₂ :: S <:+ T) → S <:+ T := by
    rintro T (hT | hT) <;> exact (List.suffix_cons _ _).trans hT
  have hc : S <:+ c.stack := hsuf _ (hd.last_prop (.inl (List.suffix_refl _)))
  have hcomp := hlast.traceCompletes_back (t := []) hc
    ⟨[], [], [], rfl, rfl, .nil, fun _ => rfl, rfl⟩
  have := traceCompletes_back_of_traceSteps hsuf hd (List.suffix_cons _ _) hcomp
  obtain ⟨F, t₁, t₂, hF, ht, -, hskip, hfr⟩ := this
  obtain rfl := hskip rfl
  have : F = [StackItem.loop1 e₁ s₁ e₂ s₂] := by
    have h' : [StackItem.loop1 e₁ s₁ e₂ s₂] ++ S = F ++ S := hF
    exact (List.append_cancel_right h').symm
  subst this
  obtain ⟨l, t₃, hl, rfl, rfl⟩ := FramesTrace.cons_iff.1 hfr
  simpa [ht] using hl

end Janus

end
